    "@types/papaparse": "5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.2.3",
    "drizzle-kit": "0.31.8",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "tailwindcss": "^4",
