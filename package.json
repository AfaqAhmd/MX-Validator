    "lucide-react": "0.561.0",
    "next": "16.0.10",
    "papaparse": "5.5.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-dropzone": "14.3.8",
    "recharts": "3.6.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0"
