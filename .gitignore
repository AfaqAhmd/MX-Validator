# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# User uploaded/test data
*.csv
!sample-leads.csv

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - NEVER commit secrets
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
!.env.example

# secrets & credentials
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
secrets.json
credentials.json
service-account*.json
*-credentials.json
.secrets
.credentials

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
